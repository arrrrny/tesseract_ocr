    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter",
            "type": "dart",
            "request": "launch",
            "program": "example/lib/main.dart"
        },
        {
            "name": "tesseract_ocr",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "tesseract_ocr (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "tesseract_ocr (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "example",
            "cwd": "example",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "example (profile mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "example (release mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Debug OCR integration",
            "type": "dart",
            "request": "launch",
            "cwd": "example",
            "program": "integration_test/tesseract_ocr_android_test.dart",
            "deviceId": "emulator-5554",
            "runTestsOnDevice": true,
            "env": {
                "ORG_GRADLE_PROJECT_skipDependencyChecks": "true"
            }
        }
    ]
