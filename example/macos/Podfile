platform :osx, '10.13'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# SwiftyTesseract 4.0.1 is Swift Package Manager only upstream, so the plugin
# carries its own podspec; libtesseract (the binary it links) is a local pod that
# is not on trunk. Both live in the plugin's ios/ directory, which is also where
# libtesseract.xcframework has to be dropped (see CUSTOM_PODS_README.md).
pod 'SwiftyTesseract401', :podspec => '../../ios/SwiftyTesseract401.podspec'
pod 'libtesseract', :path => '../../ios'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} does not exist; run 'flutter pub get' first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}; run 'flutter pub get' first"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # SwiftyTesseract is pulled in by the plugin's own `tesseract_ocr.podspec`, not
  # declared again here.
  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.13'

      # Add App Store Connect submission fix for libtesseract
      if target.name.include?("SwiftyTesseract") || target.name.include?("libtesseract")
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end
end